<?xml version="1.0" encoding="utf-8"?>
<!-- The Google Play build links out to GitHub Sponsors rather than opening the donation sheet. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Play updates through Play. An app on Play has no business installing packages, and CI
         asserts this permission is absent from the bundle. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            tools:node="remove" />
    </application>

</manifest>
