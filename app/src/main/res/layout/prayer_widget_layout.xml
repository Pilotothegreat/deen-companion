<?xml version="1.0" encoding="utf-8"?>
<!-- Prayer Time Widget: Material 3 Expressive layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.08"
            android:textStyle="bold" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_indicator_dot" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Center Hero Section -->
    <TextView
        android:id="@+id/widget_prayer_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dhuhr"
        android:textColor="@color/widget_text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_prayer_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="12:30 PM"
        android:textColor="@color/widget_accent"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <!-- Countdown Pill Badge -->
    <TextView
        android:id="@+id/widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="in 2h 15m"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/widget_chip_background"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp" />

</LinearLayout>
