<?xml version="1.0" encoding="utf-8"?>
<!-- Tasbih Widget: Material You — round counter + large + tap button -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp"
    android:gravity="fill">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tasbih"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:textAllCaps="true" />
    </LinearLayout>

    <!-- Spacer -->
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <!-- Body row: count on left, + button on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Current dhikr name -->
            <TextView
                android:id="@+id/widget_dhikr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سبحان الله"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Count -->
            <TextView
                android:id="@+id/widget_tasbih_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/widget_text_primary"
                android:textSize="36sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="0.9" />

        </LinearLayout>

        <!-- Increment button -->
        <TextView
            android:id="@+id/widget_btn_container"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="+"
            android:textColor="@color/widget_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="@drawable/widget_btn_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center" />

    </LinearLayout>

    <!-- Spacer -->
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

</LinearLayout>
