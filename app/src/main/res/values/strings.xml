    <string name="occasion_ramadan_soon_body">%1$s days to go, by the Umm al-Qura calendar. A local sighting may differ by a day.</string>
    <string name="occasion_suhoor">Suhoor</string>
    <string name="occasion_suhoor_body">Eat before Fajr, even a little. Stop when the adhan begins.</string>
    <string name="occasion_iftar">Iftar</string>
    <string name="occasion_iftar_body">Break your fast at Maghrib. The fasting person\'s supplication before it is not turned away.</string>
    <string name="occasion_last_ten">The last ten nights</string>
    <string name="occasion_last_ten_body">Night %1$s of Ramadan. Seek Laylat al-Qadr in these nights.</string>
    <string name="occasion_odd_night">An odd night</string>
    <string name="occasion_odd_night_body">Night %1$s. Stand in prayer, and say: O Allah, You are Pardoning and love to pardon, so pardon me.</string>
    <string name="occasion_zakat_al_fitr">Zakat al-Fitr</string>
    <string name="occasion_zakat_al_fitr_body">Give it before the Eid prayer, on behalf of everyone in the household.</string>
    <string name="occasion_eid_al_fitr">Eid al-Fitr</string>
    <string name="occasion_eid_body">Eid mubarak. May Allah accept from us and from you.</string>
    <string name="occasion_eid_al_adha">Eid al-Adha</string>
    <string name="occasion_six_of_shawwal">Six of Shawwal</string>
    <string name="occasion_six_of_shawwal_body">Six days of fasting this month, after Ramadan, are as a year of fasting.</string>
    <string name="occasion_ten_days">The ten of Dhul-Hijjah</string>
    <string name="occasion_ten_days_body">Day %1$s. No days are more beloved to Allah for righteous deeds than these.</string>
    <string name="occasion_arafah">The day of Arafah</string>
    <string name="occasion_arafah_body">Fasting today expiates the year before and the year after, for those not on Hajj.</string>
    <string name="occasion_takbir">Takbir</string>
    <string name="occasion_takbir_body">Say the takbir aloud through these days: Allahu akbar, Allahu akbar, la ilaha illa Allah.</string>
    <string name="occasion_tasua">Tasu\'a</string>
    <string name="occasion_ashura">Ashura</string>
    <string name="occasion_ashura_body">Fasting Ashura expiates the year before it. Fast the ninth with it.</string>
    <string name="occasion_new_moon">A new month</string>
    <string name="occasion_new_moon_body">The dua for the new crescent.</string>
    <string name="occasion_white_days">The white days</string>
    <string name="occasion_white_days_body">Day %1$s. Fasting the 13th, 14th and 15th of each month is as fasting the whole month.</string>
    <string name="occasion_sunnah_fast">Monday and Thursday</string>
    <string name="occasion_sunnah_fast_body">Deeds are presented to Allah on these days, and the Prophet صلى الله عليه وسلم liked his to be presented while fasting.</string>
    <string name="hijri_maghrib">Islamic date changes at sunset</string>
    <string name="hijri_maghrib_desc">As the Islamic day does. Night-anchored things — the odd nights, al-Kahf, the takbir — are a day out without it.</string>

    <!-- Weather and travel -->
    <string name="weather_rain">It is raining</string>
    <string name="weather_rain_body">Rain is a time supplication is answered. Say: O Allah, a beneficial rain.</string>
    <string name="weather_thunder">Thunder</string>
    <string name="weather_thunder_body">Glory to the One whom the thunder glorifies with His praise, and the angels out of awe of Him.</string>
    <string name="weather_wind">Strong wind</string>
    <string name="weather_wind_body">Ask for its good and seek refuge from its harm. Do not curse the wind.</string>
    <string name="weather_snow">Snow</string>
    <string name="weather_snow_body">Water from the sky, and a time to ask.</string>
    <string name="weather_heat">Severe heat</string>
    <string name="weather_heat_body">Seek refuge from the heat of Hellfire, and be gentle with yourself and with those working outside.</string>
    <string name="weather_cold">Severe cold</string>
    <string name="weather_cold_body">Seek refuge from the cold of Hellfire, and keep wudu warm if the cold makes it hard.</string>
    <string name="travel_ask">Are you travelling?</string>
    <string name="travel_ask_body">You are about %1$s km from home. Say yes and the travel duas and a note on shortening prayers appear, and iqama alerts stop.</string>
    <string name="travel_yes">Yes, travelling</string>
    <string name="travel_no">No, I am home</string>
    <string name="travel_duas">The duas of travel</string>
    <string name="travel_duas_body">The dua on setting out, and the traveller\'s supplication, which is answered.</string>
    <string name="travel_qasr">Shortening and combining</string>
    <string name="travel_qasr_body">A traveller may pray Dhuhr, Asr and Isha as two rak\'ahs, and many scholars allow combining Dhuhr with Asr and Maghrib with Isha. The times shown are the real times here; nothing has been changed.</string>
    <string name="travel_driving">On the road?</string>
    <string name="travel_driving_body">Turn this on and the app keeps things brief until you stop.</string>
    <string name="travel_end">I am home again</string>
    <string name="smart_features">Smart suggestions</string>
    <string name="smart_weather">Weather</string>
    <string name="smart_weather_desc">Shows the dua for rain, thunder, wind and extreme temperatures. Sends your location rounded to about a kilometre to Open-Meteo, at most once an hour, only while the app is open.</string>
    <string name="smart_travel">Travel</string>
    <string name="smart_travel_desc">Asks whether you are travelling once you are more than %1$s km from home, then offers the travel duas and pauses iqama alerts.</string>
    <string name="smart_home">Home</string>
    <string name="smart_home_set">Set. Tap to move it to where you are now.</string>
    <string name="smart_home_unset">Not set yet. Tap to use your current location.</string>
</resources>
