    <string name="reliability">Make alerts arrive</string>
    <string name="reliability_intro">Anything marked in red below will delay or silence your prayer alerts.</string>
    <string name="reliability_card_title">Alerts may not arrive</string>
    <string name="reliability_card_body">Something on this phone will delay or silence the adhan. It takes a minute to put right.</string>
    <string name="reliability_notifications">Notification permission</string>
    <string name="reliability_notifications_body">Without it Android drops every alert before it is shown.</string>
    <string name="reliability_exact">Exact alarms</string>
    <string name="reliability_exact_body">Without it an alert can drift by many minutes, and a prayer time that drifts is a wrong time.</string>
    <string name="reliability_battery">Battery optimisation</string>
    <string name="reliability_battery_body">Exempt Bilal so Android does not hold an alarm until the phone is next unlocked.</string>
    <string name="reliability_channel">Adhan notifications</string>
    <string name="reliability_channel_body">The adhan category is switched off in system settings. Only you can switch it back on.</string>
    <string name="reliability_manufacturer">Your phone\'s battery manager</string>
    <string name="reliability_oem_xiaomi">On Xiaomi, Redmi and POCO: Settings > Apps > Bilal > Autostart on, and Battery saver set to No restrictions. Then lock Bilal in Recents so it is not swept away.</string>
    <string name="reliability_oem_huawei">On Huawei and Honor: Settings > Battery > App launch > Bilal > Manage manually, with all three switches on.</string>
    <string name="reliability_oem_oppo">On Oppo and Realme: Settings > Battery > Bilal > Allow background activity and Allow auto-launch.</string>
    <string name="reliability_oem_vivo">On vivo and iQOO: Settings > Battery > Background power consumption management > Bilal > Allow high background power use.</string>
    <string name="reliability_oem_samsung">On Samsung: Settings > Battery > Background usage limits, and make sure Bilal is not in Sleeping or Deep sleeping apps.</string>
    <string name="reliability_oem_other">If alerts still arrive late, look for a battery or autostart setting for Bilal in your phone\'s own settings and allow it to run in the background.</string>
    <string name="silence_during_prayer">Silence during prayer</string>
    <string name="silence_during_prayer_desc">Holds your phone quiet from the iqama and gives it back afterwards. Alarms still sound.</string>
    <string name="silence_needs_permission">Needs Do Not Disturb access</string>
    <string name="silence_grant">Allow</string>
    <string name="pre_reminder">Reminder before the adhan</string>
    <string name="pre_reminder_off">Off</string>
    <string name="widget_moment">Right now</string>
    <string name="widget_moment_desc">Whatever matters most at this moment: the night of Ramadan, iftar approaching, the dua for the rain outside. It falls back to today\'s date when there is nothing to say.</string>
